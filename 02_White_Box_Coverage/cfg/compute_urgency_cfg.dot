digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, label="CFG of compute_urgency()   N = 10, E = 13, P = 4   V(G) = 13 - 10 + 2 = 5", labelloc=t, nodesep=0.5, ranksep=0.35];
  node [shape=circle, fontname="Helvetica", fontsize=11, width=0.45, fixedsize=true, color="#52514e"];
  edge [fontname="Helvetica", fontsize=9, color="#52514e", arrowsize=0.7];
  n1 [label="1", style=filled, fillcolor="#cde2fb"]; n3 [label="3", style=filled, fillcolor="#cde2fb"];
  n5 [label="5", style=filled, fillcolor="#cde2fb"]; n7 [label="7", style=filled, fillcolor="#cde2fb"];
  n2 [label="2"]; n4 [label="4"]; n6 [label="6"]; n8 [label="8"]; n9 [label="9"]; n10 [label="10", shape=doublecircle, width=0.5];
  n1 -> n2 [label="T"]; n1 -> n3 [label="F"]; n2 -> n3;
  n3 -> n4 [label="T"]; n3 -> n5 [label="F"]; n4 -> n10;
  n5 -> n6 [label="T"]; n5 -> n7 [label="F"]; n6 -> n10;
  n7 -> n8 [label="T"]; n7 -> n9 [label="F"]; n8 -> n10; n9 -> n10;
  legend [shape=note, fixedsize=false, width=3.6, fontsize=9.5, color="#b9b8b2", label="1  if today is None\l2  today = date.today()\l3  if not due_date_str\l4  return \"No due date\"\l5  due = strptime(...);  if due <= today\l6  return \"Overdue\"\l7  delta = (due - today).days;  if delta <= 2\l8  return \"Due Soon\"\l9  return \"Upcoming\"\l10 exit\l(shaded = predicate node)\l"];
  {rank=same; n10; legend}
}
